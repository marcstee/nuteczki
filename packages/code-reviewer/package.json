{
  "name": "@nuteczki/code-reviewer",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone entry-point for AI code review built on the Claude Agent SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "review": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "smoke": "tsx src/smoke.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.178",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
